# Supabase Edge Function secrets for deputy-sync.
# Set these with:  supabase secrets set KEY=value   (NEVER commit real values)
# Placeholders only — do not paste real credentials into this file.

# Deputy tenant REST base (verified tenant below) and a VALID permanent token.
# The token is sent as:  Authorization: OAuth <DEPUTY_API_TOKEN>
DEPUTY_BASE_URL=https://6ac52f24123110.au.deputy.com/api/v1
DEPUTY_API_TOKEN=__your_valid_deputy_permanent_token__

# Shared secret the caller must send as the x-sync-secret header.
DEPUTY_SYNC_SECRET=__generate_a_long_random_string__

# Supabase service role (server-side only — bypasses PostgREST schema exposure,
# which is why the deputy schema can be written even though it's not exposed).
SUPABASE_URL=https://uizimmfujhpuiqhjofzf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__service_role_key__

# Optional: competitor poll cadence etc. are unrelated to this function.
